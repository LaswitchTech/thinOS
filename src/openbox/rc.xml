<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xi="http://www.w3.org/2001/XInclude">

    <!-- ThinOS Openbox configuration -->

    <resistance>
        <strength>10</strength>
        <screen_edge_strength>20</screen_edge_strength>
    </resistance>

    <focus>
        <focusNew>yes</focusNew>
        <followMouse>no</followMouse>
        <focusLast>yes</focusLast>
        <underMouse>no</underMouse>
        <raiseOnFocus>yes</raiseOnFocus>
        <cycleRaise>yes</cycleRaise>
    </focus>

    <placement>
        <policy>Smart</policy>
        <center>yes</center>
        <monitor>Primary</monitor>
    </placement>

    <theme>
        <name>thinOS</name>
        <titleLayout>NLIMC</titleLayout>
        <keepBorder>yes</keepBorder>
        <animateIconify>yes</animateIconify>
        <font place="ActiveWindow">
            <name>sans</name>
            <size>12</size>
            <weight>bold</weight>
            <slant>normal</slant>
        </font>
        <font place="InactiveWindow">
            <name>sans</name>
            <size>12</size>
            <weight>bold</weight>
            <slant>normal</slant>
        </font>
        <font place="MenuHeader">
            <name>sans</name>
            <size>12</size>
            <weight>bold</weight>
            <slant>normal</slant>
        </font>
        <font place="MenuItem">
            <name>sans</name>
            <size>12</size>
            <weight>normal</weight>
            <slant>normal</slant>
        </font>
        <font place="OnScreenDisplay">
            <name>sans</name>
            <size>9</size>
            <weight>bold</weight>
            <slant>normal</slant>
        </font>
    </theme>

    <desktops>
        <number>1</number>
        <firstdesk>1</firstdesk>
        <names>
            <name>thinOS</name>
        </names>
        <popupTime>0</popupTime>
    </desktops>

    <resize>
        <drawContents>yes</drawContents>
        <popupShow>Nonpixel</popupShow>
        <popupPosition>Center</popupPosition>
        <popupFixedPosition>
            <x>0</x>
            <y>0</y>
        </popupFixedPosition>
    </resize>

    <margins>
        <top>0</top>
        <bottom>0</bottom>
        <left>0</left>
        <right>0</right>
    </margins>

    <dock>
        <position>TopLeft</position>
        <stacking>Above</stacking>
        <direction>Vertical</direction>
        <floating>no</floating>
        <autoHide>no</autoHide>
        <hideDelay>300</hideDelay>
        <showDelay>300</showDelay>
        <moveButton>Middle</moveButton>
    </dock>

    <keyboard>
        <chainQuitKey>C-g</chainQuitKey>
        <!-- Keybindings can be added here later if needed for thinOS -->
    </keyboard>

    <mouse>
        <dragThreshold>8</dragThreshold>
        <doubleClickTime>200</doubleClickTime>
        <screenEdgeWarpTime>400</screenEdgeWarpTime>
        <screenEdgeWarpMouse>false</screenEdgeWarpMouse>

        <!-- Titlebar behavior (including double-click maximize) -->
        <context name="Titlebar">
            <!-- <mousebind button="Left" action="Press">
                <action name="Focus"/>
                <action name="Raise"/>
            </mousebind> -->
            <mousebind button="Left" action="Drag">
                <action name="Move"/>
            </mousebind>
        </context>

        <!-- Titlebar button: Close -->
        <context name="Titlebar Close">
            <mousebind button="Left" action="Click">
                <action name="Close"/>
            </mousebind>
        </context>

        <!-- Titlebar button: Maximize -->
        <context name="Titlebar Maximize">
            <mousebind button="Left" action="Click">
                <action name="ToggleMaximizeFull"/>
            </mousebind>
        </context>

        <!-- Titlebar button: Iconify / Minimize -->
        <context name="Titlebar Iconify">
            <mousebind button="Left" action="Click">
                <action name="Iconify"/>
            </mousebind>
        </context>

        <!-- Root (desktop) right-click menu -->
        <context name="Root">
            <mousebind button="Right" action="Press">
                <action name="ShowMenu">
                    <menu>root-menu</menu>
                </action>
            </mousebind>
        </context>
    </mouse>

    <menu>
        <file>menu.xml</file>
        <hideDelay>200</hideDelay>
        <middle>no</middle>
        <submenuShowDelay>100</submenuShowDelay>
        <submenuHideDelay>400</submenuHideDelay>
        <applicationIcons>yes</applicationIcons>
        <manageDesktops>no</manageDesktops>
    </menu>

    <applications>
        <!-- Per-application rules can be added here if needed for kiosk/thin-client behavior -->
    </applications>

</openbox_config>
